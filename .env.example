# Python API (api/index.py) 와 rag/ 가 읽는 값. 실제 키는 .env 에만 두고 커밋하지 않는다.
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_ANSWER_MODEL=gpt-4.1-mini
RAG_TOP_K=6
RAG_FETCH_K=20
RAG_REBUILD_INDEX=0
RAG_RUN_LLM=1
# 프론트를 다른 도메인의 API에 붙일 때만 설정 (같은 Vercel 프로젝트면 비워 둠)
NEXT_PUBLIC_API_BASE_URL=
CORS_ALLOW_ORIGINS=http://localhost:3000
